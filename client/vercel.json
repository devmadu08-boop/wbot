{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://103.195.7.243:3000/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "http://103.195.7.243:3000/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
